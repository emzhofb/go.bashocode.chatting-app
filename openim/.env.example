# Local development only. Copy to .env; never use these values in production.
# Production secrets must come from the deployment secret manager.

COMPOSE_PROJECT_NAME=openim-chat-poc

# Pin all images to explicit release tags. Do not replace with latest.
MONGO_IMAGE=mongo:7.0
REDIS_IMAGE=redis:7.0.0
ETCD_IMAGE=bitnamilegacy/etcd:3.5.13
KAFKA_IMAGE=bitnamilegacy/kafka:3.5.1
MINIO_IMAGE=minio/minio:RELEASE.2024-01-11T07-46-16Z
OPENIM_SERVER_IMAGE=openim/openim-server:v3.8.3-patch.12
OPENIM_CHAT_IMAGE=openim/openim-chat:v1.8.4-patch.2
POSTGRES_IMAGE=postgres:16-alpine

# Bind public development ports to loopback only.
OPENIM_API_PORT=10002
OPENIM_MSG_GATEWAY_PORT=10001
OPENIM_CHAT_API_PORT=10008
OPENIM_ADMIN_API_PORT=10009
MINIO_PORT=10005
MINIO_CONSOLE_PORT=10004

# Development credentials. These are intentionally non-production placeholders.
MONGO_ROOT_USERNAME=root
MONGO_ROOT_PASSWORD=dev-only-change-me-mongo-root
MONGO_DATABASE=openim_v3
MONGO_USERNAME=openIM
MONGO_PASSWORD=dev-only-change-me-mongo
REDIS_PASSWORD=dev-only-change-me-redis
MINIO_ACCESS_KEY_ID=openim-local
MINIO_SECRET_ACCESS_KEY=dev-only-change-me-minio
OPENIM_SECRET=dev-only-change-me-openim
POSTGRES_APP_USER=app_chat
POSTGRES_APP_PASSWORD=dev-only-change-me-app-db
POSTGRES_APP_DATABASE=app_chat

# app-api identity/session configuration.
APP_ENV=development
APP_HTTP_ADDR=:8080
APP_DATABASE_URL=postgresql://app_chat:dev-only-change-me-app-db@postgres:5432/app_chat?sslmode=disable&connect_timeout=10
APP_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
APP_BCRYPT_COST=12
APP_ACCESS_TOKEN_TTL=15m
APP_REFRESH_TOKEN_TTL=720h
APP_READINESS_TIMEOUT=3s
APP_SHUTDOWN_TIMEOUT=10s
APP_LOG_LEVEL=info
OPENIM_ADMIN_SECRET=dev-only-change-me-openim
OPENIM_ADMIN_USER_ID=imAdmin
OPENIM_PLATFORM_ID=5
OPENIM_HTTP_TIMEOUT=10s
OPENIM_PUBLIC_API_URL=http://127.0.0.1:10002
OPENIM_PUBLIC_WS_URL=ws://127.0.0.1:10001

# OpenIM service wiring (internal Docker DNS names).
MONGO_ADDRESS=mongo:27017
REDIS_ADDRESS=redis:6379
ETCD_ADDRESS=etcd:2379
KAFKA_ADDRESS=kafka:9092
MINIO_INTERNAL_ADDRESS=minio:9000
MINIO_EXTERNAL_ADDRESS=http://127.0.0.1:10005
OPENIM_API_URL=http://openim-server:10002
LOG_IS_STDOUT=true
LOG_LEVEL=6
