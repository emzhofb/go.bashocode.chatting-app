# Copy this file to .env for local development:
# cp .env.example .env
# Never use these development values in staging or production.

APP_ENV=development
APP_HTTP_ADDR=:8080
APP_INTERNAL_HTTP_ADDR=:8081
APP_DATABASE_URL="postgresql://app_chat:development-only@localhost:5432/app_chat?sslmode=disable"
APP_PUBLIC_BASE_URL=http://localhost:6060
APP_ALLOWED_ORIGINS=http://localhost:3000
APP_BCRYPT_COST=12
APP_ACCESS_TOKEN_TTL=15m
APP_REFRESH_TOKEN_TTL=720h
APP_READINESS_TIMEOUT=3s
APP_SHUTDOWN_TIMEOUT=10s
APP_LOG_LEVEL=debug

POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=development-only
POSTGRES_TINODE_USER=tinode_admin
POSTGRES_TINODE_PASSWORD=development-only
POSTGRES_APP_PASSWORD=development-only

# The official image is linux/amd64; Docker Desktop can emulate it on Apple Silicon.
TINODE_PLATFORM=linux/amd64
TINODE_IMAGE=tinode/tinode:0.25.3
TINODE_PUBLIC_URL=http://localhost:6060
TINODE_REST_AUTH_URL=http://app-api:8081/internal/tinode/auth/
TINODE_POSTGRES_DSN="postgresql://tinode_admin:development-only@postgres:5432/tinode?sslmode=disable&connect_timeout=10"
TINODE_API_KEY_SALT=T713/rYYgW7g4m3vG6zGRh7+FM1t0T8j13koXScOAj4=
TINODE_AUTH_TOKEN_KEY=wfaY2RgF2S1OQI/ZlK+LSrp1KB2jwAdGAIHQ7JZn+Kc=
TINODE_UID_ENCRYPTION_KEY=la6YsO+bNX/+XIkOqc5Svw==
TINODE_RESET_DB=false
TINODE_UPGRADE_DB=false

# These stay disabled until their milestones are implemented.
TINODE_WEBRTC_ENABLED=false
TINODE_FCM_PUSH_ENABLED=false
TINODE_TNPG_PUSH_ENABLED=false
